# 카카오 "나에게 보내기" 자격증명 (값은 커밋 금지 — .env로 복사해 채우세요)
# 실제 값은 .env 파일에만 두고, .gitignore로 추적에서 제외됩니다.

# Kakao Developers 콘솔 > 앱 설정 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# kakao_auth.py 실행 후 자동 저장됩니다(수동 입력 불필요).
KAKAO_REFRESH_TOKEN=

# (선택) 콘솔에서 보안 > Client Secret 을 '사용함'으로 설정한 경우에만 채웁니다.
# KAKAO_CLIENT_SECRET=

# (선택) Reddit OAuth2 client_credentials(application-only) 모드용.
# 둘 다 채우면 collect.py가 공개 JSON(top.json) 대신 oauth.reddit.com을 사용합니다.
# https://www.reddit.com/prefs/apps 에서 "script" 타입 앱 생성 후 확인 가능합니다.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Gemini API 키(https://aistudio.google.com/apikey) — 각 글의 한글 번역·요약에 사용됩니다.
GEMINI_API_KEY=

# (선택) 기본값은 summarize.py의 DEFAULT_MODEL(gemini-3.5-flash)을 사용합니다.
# GEMINI_MODEL=

# ── Google Drive 공개 업로드 (카카오 PDF 링크용) ──────────────────────
# 개인 Gmail은 서비스계정 불가 → OAuth 사용. GCP에서 Drive API 사용설정 + OAuth 클라이언트
# (데스크톱 앱)를 만들어 아래를 채우세요.
# ⚠️ OAuth 동의화면을 반드시 '프로덕션'으로 게시하세요 — '테스트' 단계면 refresh token이
#    7일 만에 만료돼 발송이 죽습니다.
# GCP > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(데스크톱 앱)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# gdrive_auth.py 실행 후 자동 저장됩니다(수동 입력 불필요).
GDRIVE_REFRESH_TOKEN=

# (선택) 업로드 대상 폴더 ID. 비우면 My Drive 루트에 올립니다.
# (Drive에서 폴더 열었을 때 URL의 folders/ 뒤 문자열)
# GDRIVE_FOLDER_ID=
